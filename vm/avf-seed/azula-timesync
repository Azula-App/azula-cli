#!/usr/bin/env python3
"""Set the guest clock from an HTTP Date header fetched through the host proxy.

AVF guests get no working RTC (u-boot lists rtc-pl031 without a device) and no
NIC for NTP, so they boot at systemd's build-time epoch and TLS rejects
current certificates. One plain-http HEAD through the host app's proxy gives
the time to within a second; the timer repeats it so the clock also recovers
after the phone suspends the VM.
"""
import email.utils
import subprocess
import sys
import time
import urllib.request

URL = "http://deb.debian.org/"
opener = urllib.request.build_opener(urllib.request.ProxyHandler({"http": "http://127.0.0.1:3128"}))
err = None
for _ in range(30):
    try:
        with opener.open(urllib.request.Request(URL, method="HEAD"), timeout=5) as r:
            date = r.headers.get("Date")
        if date:
            ts = int(email.utils.parsedate_to_datetime(date).timestamp())
            before = time.time()
            subprocess.run(["date", "-u", "-s", f"@{ts}"], check=True, stdout=subprocess.DEVNULL)
            print(f"azula-timesync: clock set from {URL} Date: {date} (was off by {ts - before:+.0f}s)")
            sys.exit(0)
    except Exception as e:  # noqa: BLE001 - retry anything until the proxy is up
        err = e
    time.sleep(2)
print(f"azula-timesync: failed: {err}", file=sys.stderr)
sys.exit(1)
